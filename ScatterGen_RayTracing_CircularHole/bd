#!/bin/sh
# build ScatterGen_CircularHole:  ./bd   (CUDA_HOME=/path/to/cuda ./bd for another CUDA installation)
set -e
cd "$(dirname "$0")"
CUDA_HOME=${CUDA_HOME:-/usr/local/cuda-12.6}
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LIBRARY_PATH="$CUDA_HOME/lib64${LIBRARY_PATH:+:$LIBRARY_PATH}"

nvcc -c scatter.cu
nvcc -c ScatterGen_CircularHole.cpp
g++ -o ScatterGen_CircularHole scatter.o ScatterGen_CircularHole.o -L"$CUDA_HOME/lib64" -lcudart
